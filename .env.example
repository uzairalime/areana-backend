# --- server ---
PORT=3000
# Keep the server on Pakistan time so "today" and slot cutoffs are correct
TZ=Asia/Karachi
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# --- database ---
DATABASE_URL=postgresql://areana:areana@localhost:5432/areana?schema=public

# --- jwt ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- email (OTP delivery) ---
# dev: Mailpit from docker-compose (localhost:1025), no user/pass needed
# prod: plug in Resend / SendGrid SMTP credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Areana <no-reply@areana.pk>

# --- seed: super admin created by `npm run db:seed` ---
ADMIN_EMAIL=admin@areana.pk
ADMIN_PASSWORD=change-me-please

# --- push notifications (FCM) ---
# false = log-only mode (dev). true needs FCM_SERVICE_ACCOUNT JSON.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT=

# --- image storage ---
# local = ./uploads served at /uploads (dev). s3 = S3-compatible bucket (prod).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
