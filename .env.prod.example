# Production env for the Oracle staging VM. On the VM, copy this to
# `.env` in areana-api/ and fill it in — docker-compose.prod.yml
# reads interpolation values from the project `.env` (it declares no
# env_file). NEVER commit `.env` — it holds secrets.
#
# <VM-IP> = the VM's public IP, e.g. 129.213.40.12. All public URLs
# below use plain http + ports: this staging box has no domain yet.
# When a domain + HTTPS lands (DuckDNS + Caddy, see
# docs/ORACLE-DEPLOY.md §8), every URL here changes and the two web
# images must be REBUILT (NEXT_PUBLIC_* is baked at build time).
#
# Compose pins PORT=3000 and TZ=Asia/Karachi itself, so those are not
# listed here.

# --- database ---
POSTGRES_USER=areana
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=areana
# REQUIRED by docker-compose.prod.yml, and it MUST point at the
# Compose `db` service (host `db`, never localhost — localhost would
# run migrations and the app against the wrong database while the
# healthcheck gate still passes). Its password MUST match
# POSTGRES_PASSWORD above, or the api container fails auth.
DATABASE_URL=postgresql://areana:<same password as POSTGRES_PASSWORD>@db:5432/areana

# --- api (required by docker-compose.prod.yml) ---
# The API hard-fails on boot unless CORS_ORIGIN lists explicit
# origins — never * here. These are the browser origins of the two
# frontends on this box.
CORS_ORIGIN=http://<VM-IP>:3001,http://<VM-IP>:3002
# Real SMTP host in prod — never localhost (Mailpit is dev-only and
# is NOT in the prod compose file).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<resend api key>
MAIL_FROM=Areana <no-reply@areana.pk>
# Generate fresh values, never reuse dev secrets:
# openssl rand -hex 32
JWT_ACCESS_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
# Compose defaults TRUST_PROXY to 1; direct ports on staging
# tolerate it, and it is required once a proxy sits in front.
TRUST_PROXY=1

# --- seed: super admin created by `npm run db:seed` ---
ADMIN_EMAIL=admin@areana.pk
ADMIN_PASSWORD=<choose a strong password>

# --- push notifications (FCM) ---
# false = log-only mode. true needs FCM_SERVICE_ACCOUNT JSON.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT=

# --- image storage ---
# local = ./uploads inside the api container (persisted in the
# `uploads` volume). s3 = S3-compatible bucket (production).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- frontend build args (NEXT_PUBLIC_* is baked at build time) ---
# The API address the browsers call. The web images must be rebuilt
# if this changes.
NEXT_PUBLIC_API_URL=http://<VM-IP>:3000
# Panels <-> player cross-links (empty disables the links).
NEXT_PUBLIC_PLAYER_URL=http://<VM-IP>:3002
NEXT_PUBLIC_PANELS_URL=http://<VM-IP>:3001
# Player site public URL (link previews, sitemap).
NEXT_PUBLIC_APP_URL=http://<VM-IP>:3002
# Google Places browser key. Add http://<VM-IP>:3002/* to the key's
# HTTP referrer restrictions, or suggestions silently fail.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=<existing browser key>
# Testing note: without a verified sending domain, Resend only
# delivers to the Resend account owner's own email — verify a domain
# before inviting real players.
