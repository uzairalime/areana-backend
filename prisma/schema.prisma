generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// RBAC — roles are data, not code. Super admin creates/edits them in-panel.
// ---------------------------------------------------------------------------
enum RoleScope {
  platform
  arena
}

enum UserStatus {
  pending
  active
  suspended
}

enum VenueStatus {
  draft
  pending
  approved
  rejected
  suspended
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

model Role {
  id          String    @id @default(cuid())
  // No longer globally unique: an owner-created role only needs a unique
  // name within that owner's roles (@@unique below); system role names
  // are kept unique in code.
  name        String
  scope       RoleScope @default(arena)
  description String?
  permissions String[] // permission keys, e.g. "bookings.approve"
  isSystem    Boolean   @default(false)
  /// Set when an arena owner created this role for their own team. Null =
  /// a platform role managed by the super admin.
  ownerId     String?
  owner       User?     @relation("RoleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Super admin can disable an owner-created role; its permissions stop
  /// applying to everyone holding it.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  users        User[]
  venueAllowed VenueAllowedRole[]

  @@unique([ownerId, name])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  city         String?
  passwordHash String? // staff only (owner/staff/super_admin). Players are OTP-only.
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  referralCode String?    @unique
  noShowCount  Int        @default(0)
  status       UserStatus @default(active)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  venues            Venue[]
  bookings          Booking[]
  favorites         Favorite[]
  reviews           Review[]
  gamePosts         GamePost[]
  deviceTokens      DeviceToken[]
  notifications     Notification[]
  waitlistEntries   SlotWaitlist[]
  promoRedemptions  PromoRedemption[]
  staffVenues       VenueStaff[]
  suggestions       VenueSuggestion[]
  auditLogs         AuditLog[]       @relation("ActorLogs")
  disputesRaised    Dispute[]        @relation("RaisedDisputes")
  disputesResolved  Dispute[]        @relation("ResolvedDisputes")
  grantedBadges     VenueBadge[]
  curatedPosts      GamePost[]       @relation("CuratedPosts")
  referralsMade     Referral[]       @relation("Referrer")
  referralsReceived Referral[]       @relation("Referee")
  refreshSessions RefreshSession[]
  rolesOwned      Role[]           @relation("RoleOwner")
  venuePayments   VenuePayment[]   @relation("PaymentRecordedBy")

}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([ip])
}

/** Server-side refresh-token sessions: rotation + reuse detection. */
model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Venues & courts
// ---------------------------------------------------------------------------
model Venue {
  id                String      @id @default(cuid())
  ownerId           String
  owner             User        @relation(fields: [ownerId], references: [id])
  name              String
  address           String
  city              String
  /// Public contact number players can call (directions, running late).
  phone             String?
  lat               Float?
  lng               Float?
  sports            String[]
  amenities         String[]
  images            String[]
  /// Rich photo entries [{ url, blurhash, width, height }] kept in
  /// lockstep with `images` (plain URLs, legacy consumers). Additive —
  /// no destructive column change; new uploads populate both.
  photos            Json                @default("[]")
  rating            Float       @default(0)
  ratingCount       Int         @default(0)
  autoAccept        Boolean     @default(false)
  minAdvanceMinutes Int         @default(120)
  maxAdvanceDays    Int         @default(14)
  archivedAt        DateTime?
  /// Subscription plan (Basic / Normal / Premium / a specialized custom
  /// plan). Null = the platform default plan applies.
  planId            String?
  plan              Plan?     @relation(fields: [planId], references: [id])
  /// Billing clock: starts at first approval. Free until anchor +
  /// plan.freeMonths (or freeUntilOverride); then yearly periods.
  billingStartAt    DateTime?
  billingPaidUntil  DateTime?
  freeUntilOverride DateTime?
  /// Materialized by the nightly billing sweep: an overdue venue is
  /// paused on public surfaces exactly like a suspended owner's venue.
  billingPaused     Boolean   @default(false)
  billingDueNotifiedFor DateTime?
  /// Per-arena court cap set by the super admin. Null = the plan's
  /// maxCourts applies. Overrides the plan when set.
  courtLimitOverride Int?
  /// Per-arena team-seat cap set by the super admin. Null = the plan's
  /// maxStaff applies. Setting it also grants staff seats even when the
  /// plan lacks the staff_accounts feature (explicit admin grant).
  staffLimitOverride Int?
  /// Super-admin moderation: none | paused | blocked | disabled. Any
  /// non-'none' state hides the venue from players everywhere (same
  /// plumbing as billingPaused); the reason is shown to the owner.
  moderationStatus  String    @default("none")
  moderationReason  String?
  moderatedAt       DateTime?
  moderatedById     String?
  status            VenueStatus @default(draft)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  courts       Court[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]
  staff        VenueStaff[]
  events       VenueEvent[]
  payments     VenuePayment[]
  promos       PromoCode[]
  allowedRoles VenueAllowedRole[]
  badges       VenueBadge[]
  gamePosts    GamePost[]

  @@index([status])
  @@index([city, status])
}

model VenueAllowedRole {
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([venueId, roleId])
}

model VenueStaff {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([venueId, userId])
}

model Court {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String // e.g. "Turf A"
  sport        String // e.g. "Football"
  size         String? // e.g. "7v7"
  surface      String? // artificial_grass | natural_grass | hard
  indoor       Boolean  @default(false)
  pricePerHour Decimal  @db.Decimal(10, 2)
  openMinutes  Int      @default(360) // 6:00 AM, minutes since midnight
  closeMinutes Int      @default(1380) // 11:00 PM
  slotMinutes  Int      @default(60)
  isActive     Boolean  @default(true)
  /// Super-admin approval for owner-created courts: approved | pending |
  /// rejected. Existing and admin-created courts are approved; a pending
  /// court is invisible to players and cannot be booked.
  status       String   @default("approved")
  /// Per-court photo entries [{ url, blurhash, width, height }] —
  /// managed by owners/admins, shown on the venue page under the
  /// court's tab. (Venues keep their own gallery + sport tags.)
  photos       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slotBlocks     SlotBlock[]
  events         VenueEvent[]
  weeklyWindows  CourtWeeklyWindow[]
  recurringBlocks RecurringBlock[]
  priceWindows   CourtPriceWindow[]
  bookings       Booking[]
  waitlistEntries SlotWaitlist[]

  @@index([venueId])
}

/// One row per open window of a weekday — multiple rows per weekday mean
/// split shifts (e.g. 06:00–11:00 and 16:00–23:00). A court with NO rows
/// at all falls back to its openMinutes/closeMinutes for every day; a
/// court WITH rows is closed on weekdays that have no row.
model CourtWeeklyWindow {
  id           String   @id @default(cuid())
  courtId      String
  court        Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  weekday      Int // 0 = Sunday … 6 = Saturday (JS getDay)
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())

  @@index([courtId, weekday])
}

/// A block that repeats on the given weekdays, optionally bounded by a
/// date range (e.g. every Friday 12:30–14:30, or a Ramadan schedule for
/// one month). One-off date blocks stay in SlotBlock.
model RecurringBlock {
  id           String    @id @default(cuid())
  courtId      String
  court        Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  weekdays     Int[] // 0 = Sunday … 6 = Saturday
  startMinutes Int
  endMinutes   Int
  reason       String?
  startsOn     DateTime? @db.Date
  endsOn       DateTime? @db.Date
  createdAt    DateTime  @default(now())

  @@index([courtId])
}

/// A peak/off-peak rate window: on the given weekdays, slots starting
/// inside [startMinutes, endMinutes) price at pricePerHour instead of
/// the court's base rate. Optional date range for seasonal rates.
/// Windows must not overlap each other for the same slot.
model CourtPriceWindow {
  id           String    @id @default(cuid())
  courtId      String
  court        Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  weekdays     Int[] // 0 = Sunday … 6 = Saturday
  startMinutes Int
  endMinutes   Int
  pricePerHour Decimal   @db.Decimal(10, 2)
  startsOn     DateTime? @db.Date
  endsOn       DateTime? @db.Date
  createdAt    DateTime  @default(now())

  @@index([courtId])
}

model SlotBlock {
  id           String   @id @default(cuid())
  courtId      String
  court        Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startMinutes Int
  endMinutes   Int
  reason       String?
  createdAt    DateTime @default(now())

  @@index([courtId, date])
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------
model Booking {
  id             String        @id @default(cuid())
  userId         String? // null for walk-ins
  user           User?         @relation(fields: [userId], references: [id])
  guestName      String?
  venueId        String
  venue          Venue         @relation(fields: [venueId], references: [id])
  courtId        String
  court          Court         @relation(fields: [courtId], references: [id])
  date           DateTime      @db.Date
  startMinutes   Int // minutes since midnight
  endMinutes     Int
  totalPrice     Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  promoCodeId    String?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id])
  status         BookingStatus @default(pending)
  shareCode      String?       @unique // group booking join link
  checkInCode    String        @unique // QR shown in app, scanned by venue
  checkedInAt    DateTime?
  reminderSent   Boolean       @default(false)
  recurrenceId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  participants     BookingParticipant[]
  gamePost         GamePost?
  reviews          Review[]
  reschedules      RescheduleRequest[]
  disputes         Dispute[]
  promoRedemptions PromoRedemption[]

  @@unique([courtId, date, startMinutes]) // the double-booking guard
  @@index([userId, date])
  @@index([courtId, date])
  @@index([recurrenceId])
  @@index([status, date])
}

model BookingParticipant {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  joinedAt  DateTime @default(now())

  @@index([bookingId])
}

model RescheduleRequest {
  id                    String   @id @default(cuid())
  bookingId             String
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedDate         DateTime @db.Date
  requestedStartMinutes Int
  requestedEndMinutes   Int
  status                String   @default("pending") // pending | approved | rejected
  reason                String?
  createdAt             DateTime @default(now())
  decidedAt             DateTime?

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Social: favorites, reviews, game board
// ---------------------------------------------------------------------------
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
}

model Review {
  id         String    @id @default(cuid())
  venueId    String
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  bookingId  String    @unique // one review per completed booking
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  ownerReply String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([venueId])
}

model SlotWaitlist {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courtId      String
  court        Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  startMinutes Int
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, courtId, date, startMinutes])
  @@index([courtId, date, startMinutes])
}

model GamePost {
  id            String    @id @default(cuid())
  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id])
  venueId       String?
  venue         Venue?    @relation(fields: [venueId], references: [id])
  sport         String
  city          String
  date          DateTime  @db.Date
  startMinutes  Int
  playersNeeded Int
  squadSize     Int?
  level         String?
  note          String?
  status        String    @default("open") // open | full | closed
  reminderSent  Boolean   @default(false)
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  isCurated     Boolean   @default(false)
  curatedById   String?
  curatedBy     User?     @relation("CuratedPosts", fields: [curatedById], references: [id])
  createdAt     DateTime  @default(now())

  participants GameParticipant[]

  @@index([city, date, status])
}

model GameParticipant {
  id       String   @id @default(cuid())
  postId   String
  post     GamePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String?
  name     String
  phone    String?
  /** pending = join requested, awaiting the host; joined = accepted. */
  status   String   @default("joined")
  joinedAt DateTime @default(now())

  @@index([postId])
}

// ---------------------------------------------------------------------------
// Promos & referrals
// ---------------------------------------------------------------------------
model PromoCode {
  id           String    @id @default(cuid())
  /// Null = a platform-wide promo (super admin). Set = an owner-managed
  /// promo valid only at that venue.
  venueId      String?
  venue        Venue?    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdById  String?
  code         String    @unique
  kind         String // percent | flat
  value        Decimal   @db.Decimal(10, 2)
  maxDiscount  Decimal?  @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int       @default(0)
  perUserLimit Int       @default(1)
  validFrom    DateTime  @default(now())
  validTo      DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions PromoRedemption[]
  bookings    Booking[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId  String   @unique
  referee    User     @relation("Referee", fields: [refereeId], references: [id])
  status     String   @default("pending") // pending | rewarded
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Platform: badges, disputes, banners, suggestions, audit
// ---------------------------------------------------------------------------
model Badge {
  id                  String   @id @default(cuid())
  name                String
  tier                Int
  criteriaDescription String?
  iconUrl             String?
  createdAt           DateTime @default(now())

  venues VenueBadge[]
}

model VenueBadge {
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation(fields: [grantedById], references: [id])

  @@id([venueId, badgeId])
}

model Dispute {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id])
  raisedById   String
  raisedBy     User      @relation("RaisedDisputes", fields: [raisedById], references: [id])
  reason       String
  status       String    @default("open") // open | resolved | dismissed
  resolution   String?
  resolvedById String?
  resolvedBy   User?     @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  blurhash  String?
  linkUrl   String?
  city      String?
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model VenueSuggestion {
  id            String  @id @default(cuid())
  suggestedById String?
  suggestedBy   User?   @relation(fields: [suggestedById], references: [id])
  name          String
  city          String
  phone         String?
  note          String?
  status        String  @default("new") // new | contacted | converted | dismissed
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  /// Optional human-readable detail (e.g. which fields an edit changed).
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Subscription plans for venues. Features are keys from the plan
/// feature catalog (src/plans/plans.service.ts); limits are null =
/// unlimited. A plan with isCustom = true is a specialized plan built
/// for one specific arena by the super admin.
model Plan {
  id          String   @id @default(cuid())
  name        String
  priceYearly Int      @default(0)
  freeMonths  Int      @default(3)
  features    Json     @default("[]")
  maxVenues   Int?
  maxCourts   Int?
  maxStaff    Int?
  isDefault   Boolean  @default(false)
  isCustom    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venues      Venue[]
  payments    VenuePayment[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// In-app inbox copy of every personal notification (booking decisions,
/// reminders, reschedule outcomes, game joins). Rows are written by
/// NotificationsService.pushToUser alongside the push/email fan-out;
/// broadcast campaigns are not fanned out into inboxes.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Arena view / click tracking. One row per identity per venue (or court)
// per day: the unique dedupeKey makes "1 view per user per day" a database
// guarantee, not an app hope. identity = user id, or "g:<visitorId>" for
// guests, or "ip:<ip>" as a last resort.
// ---------------------------------------------------------------------------
model VenueEvent {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courtId   String?
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: SetNull)
  type      String // view | click | court_view
  identity  String
  userId    String?
  day       DateTime @db.Date
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([venueId, type, day])
  @@index([courtId, type, day])
}

// ---------------------------------------------------------------------------
// Subscription payments ledger: every "mark paid" (and any manual entry)
// writes a row, so platform revenue and per-arena revenue are sums of real
// records, not flags.
// ---------------------------------------------------------------------------
model VenuePayment {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount       Int // PKR
  method       String? // bank | raast | cash | other
  periodStart  DateTime?
  periodEnd    DateTime?
  note         String?
  recordedById String?
  recordedBy   User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([venueId, createdAt])
}

// ---------------------------------------------------------------------------
// Broadcast history: every admin broadcast is recorded at send time so the
// CMS can show what went out, when, to which city and how many devices it
// targeted.
// ---------------------------------------------------------------------------
model Broadcast {
  id        String   @id @default(cuid())
  title     String
  body      String
  city      String?
  targeted  Int      @default(0)
  sentById  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The sports catalog — created and managed ONLY by the super admin.
/// Venues/courts reference sports by (canonical) name; writes are
/// validated against this table so the list can never fragment.
model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
